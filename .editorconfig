# ============================================================
# AI Enterprise CRM  (.editorconfig)
# 统一不同编辑器 / IDE 的缩进、编码与换行符
# 参考：https://editorconfig.org
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------- 按语言细化 ----------

[*.{json,yml,yaml,ini,conf}]
indent_size = 2

[*.{html,tpl,css,scss}]
indent_size = 2

[*.md]
# Markdown 行尾两个空格表示换行，不能裁剪
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

# ---------- 排除第三方资源 ----------

[{deploy/i18n/**,deploy/patches/**,crm/vendor/**,crm/cache/**}]
trim_trailing_whitespace = false
insert_final_newline = false

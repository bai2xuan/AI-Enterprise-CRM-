# ============================================================
# AI Enterprise CRM —— 部署配置模板
# 使用方法：复制为 .env 并按需修改
#   cp .env.example .env
# ============================================================

# ---------- 对外访问 ----------
HTTP_PORT=8080
SITE_URL=http://localhost:8080
SYSTEM_NAME=智联AI CRM

# ---------- 数据库 ----------
DB_ROOT_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ---------- SuiteCRM 管理员 ----------
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ---------- 本地化 ----------
# en_us（默认）或 zh_CN（需先安装中文语言包）
DEFAULT_LANGUAGE=zh_CN
